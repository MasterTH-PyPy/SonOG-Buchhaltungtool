<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SonOG.Buchhaltung.App</RootNamespace>
    <AssemblyName>SonOG.Buchhaltung</AssemblyName>
    <!-- Erlaubt das Kompilieren auch auf Linux/CI-Servern -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="SonOG.Buchhaltung.App.Resources.app.ico" />
    <None Include="Resources\app.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SonOG.Buchhaltung.Infrastructure\SonOG.Buchhaltung.Infrastructure.csproj" />
  </ItemGroup>
</Project>
