<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Versionsstand: VersionPrefix (Haupt-/Nebenversion) und BuildNummer stehen hier fest und werden bei JEDEM Commit
    gepflegt: BuildNummer +1 (siehe CLAUDE.md). So ist die Version unabhängig davon, ob beim Bauen Git verfügbar ist.
    Ist Git verfügbar, kommt der Commit-Kurzhash dazu, und "+lokal", wenn nicht eingecheckte Änderungen enthalten sind.
  -->
  <PropertyGroup>
    <VersionPrefix>1.1</VersionPrefix>
    <BuildNummer>22</BuildNummer>
    <Version>$(VersionPrefix).$(BuildNummer)</Version>
    <FileVersion>$(VersionPrefix).$(BuildNummer).0</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$(BuildNummer).0</AssemblyVersion>
    <InformationalVersion>$(VersionPrefix).$(BuildNummer)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="SonOGGitHash" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SonOGGitHash" />
      <Output TaskParameter="ExitCode" PropertyName="SonOGGitExit" />
    </Exec>
    <Exec Command="git diff --quiet HEAD --" IgnoreExitCode="true" EchoOff="true" ContinueOnError="true" StandardOutputImportance="low"
          StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(SonOGGitExit)' == '0'">
      <Output TaskParameter="ExitCode" PropertyName="SonOGGitDirty" />
    </Exec>
    <PropertyGroup Condition="'$(SonOGGitExit)' == '0' And '$(SonOGGitHash)' != ''">
      <InformationalVersion>$(VersionPrefix).$(BuildNummer) ($(SonOGGitHash))</InformationalVersion>
      <InformationalVersion Condition="'$(SonOGGitDirty)' != '0'">$(VersionPrefix).$(BuildNummer) ($(SonOGGitHash)+lokal)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
